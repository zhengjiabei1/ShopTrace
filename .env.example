# These variables belong to the backend, never the browser.
# Copy values into your shell; the app does not automatically load .env files.
LAB_DATA_DIR=./artifacts
# A ShopSimulator instance running locally or reached through an SSH tunnel.
SHOPSIM_BASE_URL=http://127.0.0.1:5700
# OpenAI-compatible inference endpoint, local Mac or remote API.
# LLM_BASE_URL=http://127.0.0.1:8000/v1
# LLM_MODEL=your-model-name
# LLM_API_KEY=your-key
# DeepSeek profile (configure LLM_API_KEY separately in the backend credential mechanism).
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-flash
# Verify account model availability and two-round tools with:
# python -m webagent check-model --deepseek

# OpenCode Go profile (paid route; requires the session header as well as the key).
# LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
# LLM_MODEL=deepseek-v4.1-flash
# LLM_API_KEY=your-opencode-key
# OPENCODE_SESSION_ID=your-opencode-session
# python -m webagent check-model
