# Copy to ignored deploy/runtime.env and inject secrets in your hosting system.
WEBAGENT_PUBLIC_ORIGIN=https://shoptrace.example.com
WEBAGENT_AUTH_USER=owner
# Required: SHA256 of a long, separate web-login password. No default password.
WEBAGENT_AUTH_PASSWORD_SHA256=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
LLM_API_KEY=
